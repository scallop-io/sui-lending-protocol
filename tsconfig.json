{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "baseUrl": ".",
    // path aliases replace the old `tsconfig-paths/register` hook, which is CJS-only
    "paths": {
      "sui-elements": [
        "./sui-elements/index.ts"
      ],
      "contracts/*": [
        "./contracts/*"
      ]
    },
    // output .d.testnet-data-setup declaration files for consumers
    "declaration": true,
    "emitDeclarationOnly": true,
    // output .js.map sourcemap files for consumers
    "sourceMap": true,
    // match output dir to input dir. e.g. dist/index instead of dist/src/index
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "esModuleInterop": true,
    // @mysten/sui v2 and @scallop-io/sui-kit v3 are ESM-only and expose their
    // entrypoints through the `exports` map, so `node` resolution cannot see them
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true
  },
  "exclude": [
    "node_modules",
    "example",
    "dist",
  ]
}
